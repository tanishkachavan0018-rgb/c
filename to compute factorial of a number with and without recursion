
#include <stdio.h>

// Function using recursion
int factorial_recursive(int n)
{
    if(n == 0 || n == 1)
        return 1;
    else
        return n * factorial_recursive(n - 1);
}

// Function without recursion
int factorial_iterative(int n)
{
    int i, fact = 1;

    for(i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

int main()
{
    int n, fact1, fact2;

    printf("Enter a number: ");
    scanf("%d", &n);

    if(n < 0)
    {
        printf("Factorial is not defined for negative numbers.");
    }
    else
    {
        fact1 = factorial_recursive(n);
        fact2 = factorial_iterative(n);

        printf("\nFactorial using recursion = %d", fact1);
        printf("\nFactorial without recursion = %d", fact2);
    }

    return 0;
}
